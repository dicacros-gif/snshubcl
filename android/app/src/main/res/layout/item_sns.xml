<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/snsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="🌐" />

            <TextView
                android:id="@+id/snsName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Facebook"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/langToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLangKo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KO"
                    android:textSize="10sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:minHeight="32dp"
                    app:strokeColor="@color/accent_blue"
                    android:textColor="@color/accent_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLangEn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EN"
                    android:textSize="10sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:minHeight="32dp"
                    app:strokeColor="@color/accent_blue"
                    android:textColor="@color/accent_blue" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="웹으로 열기"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/accent_primary"
                android:textColor="@color/bg_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApp"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="앱으로 열기"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/divider"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="이 캡션으로 공유"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFind"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="👥 친구찾기 · 팔로우 (직접)"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/accent_blue"
            android:textColor="@color/accent_blue" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
