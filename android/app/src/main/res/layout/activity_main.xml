<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 통합 제어 센터 (헤더 문구 삭제됨) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="작동 모드 선택"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/modeToggleGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeAuto"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="자동화"
                                android:textSize="11sp"
                                app:strokeColor="@color/divider" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeManual"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="수동작업"
                                android:textSize="11sp"
                                app:strokeColor="@color/divider" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="동작 간격 설정"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/intervalToggleGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRandomInterval"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="랜덤"
                                android:textSize="11sp"
                                app:strokeColor="@color/divider" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFixedInterval"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="고정"
                                android:textSize="11sp"
                                app:strokeColor="@color/divider" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <!-- 고정 간격 입력창 -->
                    <LinearLayout
                        android:id="@+id/fixedIntervalLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                        <EditText
                            android:id="@+id/editFixedSeconds"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:hint="간격(초)"
                            android:inputType="number"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:backgroundTint="@color/accent_primary"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:paddingVertical="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp">

                        <CheckBox
                            android:id="@+id/checkAutoFriend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="친구추가"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/checkAutoLike"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="좋아요"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/checkAutoComment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="댓글작성"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 플랫폼 리스트 (헤더 문구 삭제됨) -->
            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
